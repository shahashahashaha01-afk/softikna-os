{
  "name": "softikna-os-portable",
  "version": "1.0.0",
  "description": "Softikna OS portable Windows build",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.8.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.softikna.os",
    "productName": "Softikna OS",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}